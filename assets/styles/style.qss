/* ── Global ─────────────────────────────────────────────── */
QWidget {
	background-color: #F5F6F8;
	color: #111827;
	font-family: "JetBrains Mono", "bold";
	font-size: 10pt;
}

QMainWindow {
	background-color: #F5F6F8;
}

/* ── Sidebar ─────────────────────────────────────────────── */
#Sidebar {
	background-color: #FFFFFF;
	border-right: 1px solid #E2E5EA;
	min-width: 210px;
	max-width: 210px;
}

#AppTitle {
	font-size: 13pt;
	font-weight: bold;
	color: #111827;
	padding: 20px 18px 4px 18px;
}

#AppSubtitle {
	font-size: 8pt;
	color: #6B7280;
	padding: 0px 18px 16px 18px;
}

#NavButton {
	background-color: transparent;
	border: none;
	border-radius: 6px;
	padding: 10px 14px;
	text-align: left;
	font-size: 10pt;
	color: #374151;
	margin: 2px 10px;
}

#NavButton:hover {
	background-color: #F0F4FF;
	color: #2563EB;
}

#NavButton[active="true"] {
	background-color: #EFF6FF;
	color: #2563EB;
	font-weight: bold;
	border-left: 3px solid #2563EB;
	padding-left: 11px;
}

#OperatorBadge {
	background-color: #F0F4FF;
	border-top: 1px solid #E2E5EA;
	padding: 12px 16px;
	color: #374151;
	font-size: 9pt;
}

/* ── Content area ────────────────────────────────────────── */
#ContentArea {
	background-color: #F5F6F8;
}

#PageTitle {
	font-size: 15pt;
	font-weight: bold;
	color: #111827;
	padding: 0px 0px 2px 0px;
}

#PageSubtitle {
	font-size: 9pt;
	color: #6B7280;
	padding-bottom: 8px;
}

/* ── Cards ───────────────────────────────────────────────── */
#Card {
	background-color: #FFFFFF;
	border: 1px solid #E2E5EA;
	border-radius: 10px;
	padding: 20px;
}

/* ── Status bar strip ────────────────────────────────────── */
#StatusStrip {
	background-color: #FFFFFF;
	border-bottom: 1px solid #E2E5EA;
	padding: 6px 20px;
}

#StatusLabel {
	font-size: 8.5pt;
	color: #6B7280;
}

#StatusValue {
	font-size: 8.5pt;
	color: #111827;
	font-weight: bold;
}

/* ── Form elements ───────────────────────────────────────── */
QLineEdit, QComboBox {
	background-color: #FFFFFF;
	border: 1px solid #D1D5DB;
	border-radius: 6px;
	padding: 0px 0px;
	color: #111827;
	selection-background-color: #DBEAFE;
}

QLineEdit:focus, QComboBox:focus {
	border: 1.5px solid #2563EB;
	background-color: #FAFCFF;
}

QLineEdit:read-only {
	background-color: #F9FAFB;
	color: #9CA3AF;
}

QComboBox::drop-down {
	border: none;
	width: 24px;
}

QComboBox::down-arrow {
	width: 10px;
	height: 10px;
}

QComboBox QAbstractItemView {
	background-color: #FFFFFF;
	border: 1px solid #E2E5EA;
	border-radius: 6px;
	selection-background-color: #EFF6FF;
	selection-color: #000000;
}

QLabel {
	color: #374151;
	font-size: 9.5pt;
	background: transparent;
}

/* ── Buttons ─────────────────────────────────────────────── */
QPushButton {
	background-color: #2563EB;
	color: #FFFFFF;
	border: none;
	border-radius: 7px;
	padding: 8px 18px;
	font-size: 10pt;
	font-weight: bold;
}

QPushButton:hover {
	background-color: #1D4ED8;
}

QPushButton:pressed {
	background-color: #1E40AF;
}

#SecondaryButton {
	background-color: #FFFFFF;
	color: #374151;
	border: 1px solid #D1D5DB;
	font-weight: normal;
}

#SecondaryButton:hover {
	background-color: #F9FAFB;
	border-color: #9CA3AF;
}

#DangerButton {
	background-color: #FFFFFF;
	color: #DC2626;
	border: 1px solid #FCA5A5;
	font-weight: normal;
}

#DangerButton:hover {
	background-color: #FEF2F2;
}

/* ── Table ───────────────────────────────────────────────── */
QTableWidget {
	background-color: #FFFFFF;
	border: 1px solid #E2E5EA;
	border-radius: 8px;
	gridline-color: #F3F4F6;
	selection-background-color: #EFF6FF;
	selection-color: #111827;
	alternate-background-color: #FAFAFA;
}

QTableWidget::item {
	padding: 8px 10px;
	border-bottom: 1px solid #F3F4F6;
}

QTableWidget::item:selected {
	background-color: #EFF6FF;
	color: #111827;
}

QHeaderView::section {
	background-color: #F9FAFB;
	border: none;
	border-bottom: 2px solid #E2E5EA;
	border-right: 1px solid #F3F4F6;
	padding: 9px 10px;
	font-weight: bold;
	color: #374151;
	font-size: 9pt;
}

/* ── Scrollbars ──────────────────────────────────────────── */
QScrollBar:vertical {
	background: transparent;
	width: 8px;
	margin: 0;
}

QScrollBar::handle:vertical {
	background: #D1D5DB;
	border-radius: 4px;
	min-height: 30px;
}

QScrollBar::handle:vertical:hover {
	background: #9CA3AF;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
	height: 0;
}

QScrollBar:horizontal {
	background: transparent;
	height: 8px;
}

QScrollBar::handle:horizontal {
	background: #D1D5DB;
	border-radius: 4px;
}

/* ── Divider ─────────────────────────────────────────────── */
#Divider {
	background-color: #E2E5EA;
	max-height: 1px;
	min-height: 1px;
}

/* ── Message box ─────────────────────────────────────────── */
QMessageBox {
	background-color: #FFFFFF;
}

QMessageBox QPushButton {
	min-width: 80px;
	padding: 6px 16px;
}
